# Settings template for hardcover-mcp. The server never reads a .env file by itself.
#
# Configuring the server: copy this file somewhere outside the repository (for example
# ~/hardcover.env), put in your token, and pass it explicitly:
#     uvx --env-file ~/hardcover.env hardcover-mcp
# (or set the same variables in your MCP client's "env" block instead; see the README).
#
# Running the integration tests: copy it to .env in the repository root; the tests load it.
# .env is git-ignored, but other file names aren't, so never commit a copy with a real token.

HARDCOVER_API_TOKEN=your_token_here

# Optional: comma-separated toolsets (core, catalog, library, lists, journal, social). Default: all
# HARDCOVER_TOOLSETS=all
# Optional: hide every tool that can modify your account. Default: false
# HARDCOVER_READ_ONLY=false
# Optional: GraphQL endpoint (https only). Default: Hardcover's API
# HARDCOVER_API_URL=https://api.hardcover.app/v1/graphql
