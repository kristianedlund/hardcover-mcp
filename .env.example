HARDCOVER_API_TOKEN=your_token_here

# Optional: comma-separated toolsets (core, catalog, library, lists, journal, social). Default: all
# HARDCOVER_TOOLSETS=all
# Optional: hide every tool that can modify your account. Default: false
# HARDCOVER_READ_ONLY=false
# Optional: GraphQL endpoint (https only). Default: Hardcover's API
# HARDCOVER_API_URL=https://api.hardcover.app/v1/graphql
